    {
      "strategy": "metrics",
      "cypher": "MATCH (tc:TargetCompany)-[:HAS_METRIC_CATEGORY]->(mc:MetricCategory)-[:HAS_METRIC]->(m:Metric)\nWHERE mc.name IN ['Profitability', 'Coverage']\nWITH tc, mc, collect({citation_id: m.citation_id, name: m.name, label: m.label, gaap_concept: m.gaap_concept, value: m.value, unit: m.unit, year: m.year, metric_type: m.metric_type, xbrl_tag: m.xbrl_tag, source_page: m.source_page, section_title: m.section_title, source_text: m.source_text})[0..20] AS target_metrics\nOPTIONAL MATCH (peer:Company {is_peer:true})-[:COMPETES_WITH]->(tc)\nOPTIONAL MATCH (peer)-[:HAS_METRIC_CATEGORY]->(pmc:MetricCategory {name: mc.name})-[:HAS_METRIC]->(pm:Metric)\nWITH tc, mc, target_metrics, peer, collect({citation_id: pm.citation_id, name: pm.name, label: pm.label, gaap_concept: pm.gaap_concept, value: pm.value, unit: pm.unit, year: pm.year, metric_type: pm.metric_type, xbrl_tag: pm.xbrl_tag, source_url: pm.source_url})[0..15] AS peer_metrics\nRETURN tc.name AS target, mc.name AS category, target_metrics, peer.name AS peer, peer_metrics\nLIMIT 20"
    }
  ],
